# Copy to server/coediting/.env.local. Backend only; never use VITE_ names.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
PAPER_SHARED_HOST=127.0.0.1
PAPER_SHARED_PORT=5440
PAPER_SHARED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Comma-separated project UUIDs. Empty disables all project access.
# Do not enroll real papers until browser/lifecycle integration is complete.
PAPER_SHARED_PROJECTS=
# Both required for non-loopback hosting. Absolute certificate/key file paths.
PAPER_SHARED_TLS_KEY=
PAPER_SHARED_TLS_CERT=
