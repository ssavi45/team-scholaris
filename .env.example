# Copy to .env.local. No backend is required to preview the frontend.
# Use your hosted or local CLI project URL and a browser-safe public API key.
# VITE_SUPABASE_PUBLISHABLE_KEY accepts either an sb_publishable_ key or a
# legacy anon JWT key (with role "anon"). Keep this same variable name for either.
# For the local CLI stack, the URL is normally http://127.0.0.1:54321.
# Never place secret or service-role keys in ANY VITE_ variable: Vite exposes them.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after Google OAuth is configured in the Supabase backend.
VITE_GOOGLE_AUTH_ENABLED=false
