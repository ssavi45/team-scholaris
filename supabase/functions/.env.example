# Local function environment. Copy to .env.local in this directory.
APP_ORIGIN=http://127.0.0.1:5173
INVITE_EMAIL_PROVIDER=mailpit
INVITE_MAILPIT_URL=http://host.docker.internal:54324
# Hosted function secrets: APP_ORIGIN=https://your-frontend-origin
# INVITE_EMAIL_PROVIDER=resend, RESEND_API_KEY, INVITE_FROM
# Never put email provider secrets in VITE_ variables.

# Google Calendar / Meet integration (server only).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-calendar/callback
# 32 random bytes encoded as 64 hex characters. Keep stable: encrypts refresh tokens.
GOOGLE_CALENDAR_TOKEN_KEY=
